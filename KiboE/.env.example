# Server
PORT=3000
NODE_ENV=development

# PostgreSQL / Supabase
DATABASE_URL=
DATABASE_SSL=true

# Pool de conexiones (opcional)
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000

# Google Gemini / Generative Language API
# Soporta una o varias API keys separadas por coma. El backend rota entre
# ellas y si una pega 429 (cuota excedida) la pone en cooldown y pasa a la
# siguiente. Asi puedes combinar el tier gratis de varias cuentas Google.
# Ejemplo: EMBEDDINGS_API_KEY=AIza...key1,AIza...key2,AIza...key3
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=768

# Cuanto tiempo (ms) queda "quemada" una key tras recibir 429.
# Default: 1 hora. Si tu cuota es diaria, 3600000 permite reintentar pronto;
# si prefieres que no se intente hasta el reset diario, pon algo grande.
# EMBEDDINGS_KEY_COOLDOWN_MS=3600000

# Si vacio, el backend usa EMBEDDINGS_API_KEY (mismas llaves, mismo pool).
# Tambien acepta multiples keys separadas por coma.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# LLM_KEY_COOLDOWN_MS=3600000

API_PROVIDER=google

# ─── Proveedor de embeddings ────────────────────────────────────────────────
# "google"  -> usa EMBEDDINGS_API_KEY + EMBEDDINGS_MODEL (Gemini)
# "openai"  -> usa OPENAI_API_KEY + OPENAI_EMBEDDINGS_MODEL
# Importante: al cambiar de proveedor los vectores quedan en un espacio
# semantico distinto. Hay que reingestar los chunks. La dimension sigue
# siendo EMBEDDINGS_DIM (default 768) para no tocar el schema.
EMBEDDINGS_PROVIDER=google

# OpenAI (solo si EMBEDDINGS_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# Base URL alternativa (para proxies); por default la oficial.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Seguridad HTTP ─────────────────────────────────────────────────────────
# Origenes permitidos, separados por coma. Usar "*" solo en desarrollo.
# Ej: CORS_ORIGINS=http://localhost:5173,https://kibo.app
CORS_ORIGINS=*

# Tamano maximo de body JSON (ej. 2mb, 512kb)
# JSON_BODY_LIMIT=2mb

# trust proxy: numero de proxies entre el cliente y express.
# Usar 1 si corres detras de ngrok/nginx/cloudflare.
# TRUST_PROXY=0

# ─── Rate limit general ─────────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120

# ─── Rate limit especifico para endpoints AI (chat, assignments, etc.) ─────
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=20

# ─── Ingesta de PDFs ────────────────────────────────────────────────────────
# Algunos servidores publicos (p. ej. aprendeinea.inea.gob.mx) tienen mal
# configurada la cadena TLS (les falta el certificado intermedio). Poner en
# "true" SOLO si necesitas descargar desde esos sitios. Afecta unicamente
# al cliente de descarga de PDFs; no al resto del backend.
PDF_ALLOW_INSECURE_TLS=false

# Tamano maximo del PDF a descargar en bytes. Default 50 MB.
# PDF_MAX_BYTES=52428800
# Timeout de descarga. Default 45s.
# PDF_DOWNLOAD_TIMEOUT_MS=45000

# ─── Scraping de paginas web ───────────────────────────────────────────────
# SCRAPER_TIMEOUT_MS=15000
# SCRAPER_MAX_BYTES=10485760
# Maximo de PDFs a seguir cuando se ingesta una URL con followPdfLinks=true.
# URL_MAX_PDF_LINKS=20

# ─── Paralelismo de ingesta ────────────────────────────────────────────────
# Tamano de batch para batchEmbedContents (max 100).
# EMBED_BATCH_SIZE=100
# Cuantas llamadas batchEmbedContents paralelas por documento grande.
# EMBED_BATCH_CONCURRENCY=2
# Cuantos PDFs procesar a la vez en los endpoints /batch.
# PDF_BATCH_CONCURRENCY=3
# Tamano aproximado por chunk en caracteres.
# CHUNK_SIZE=1000

# ─── Chat ──────────────────────────────────────────────────────────────────
# Cuantos chunks usar como contexto en cada pregunta.
# CHAT_TOP_K=6
# Umbral de distancia coseno maximo para aceptar un chunk como contexto.
# 0 = identico, 1 = no relacionado. 0.55 ~ filtrado conservador.
# CHAT_RELEVANCE_MAX=0.55
# Cuantos turnos (user+assistant) del historial mandar al LLM.
# CHAT_HISTORY_TURNS=6

# ─── Gemini HTTP ───────────────────────────────────────────────────────────
# Sockets maximos en keep-alive al API de Gemini.
# GEMINI_MAX_SOCKETS=20
