# Server
PORT=3000
NODE_ENV=development

# PostgreSQL / Supabase
DATABASE_URL=
DATABASE_SSL=true

# Google Gemini / Generative Language API
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=768

# Optional: if empty, the backend falls back to EMBEDDINGS_API_KEY.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

API_PROVIDER=google
